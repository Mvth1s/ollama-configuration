{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SelfLlama Installer",
  "version": "0.1.0",
  "identifier": "com.selfllama.gui",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SelfLlama Installer",
        "width": 760,
        "height": 640,
        "minWidth": 560,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Installer GUI for the SelfLlama stack",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "../../scripts/linux/setup.sh": "scripts/setup.sh",
      "../../scripts/linux/01-install-ollama.sh": "scripts/01-install-ollama.sh",
      "../../scripts/linux/02-configure-gpu.sh": "scripts/02-configure-gpu.sh",
      "../../scripts/linux/03-pull-models.sh": "scripts/03-pull-models.sh",
      "../../scripts/linux/04-install-webui.sh": "scripts/04-install-webui.sh",
      "../../scripts/linux/lib/common.sh": "scripts/lib/common.sh",
      "../../scripts/windows/setup.ps1": "scripts/setup.ps1",
      "../../scripts/windows/lib/common.ps1": "scripts/lib/common.ps1"
    }
  }
}
